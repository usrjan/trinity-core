# ============================================
# TRINITY — КОНФИГУРАЦИЯ .env.example
# ============================================
#
# Этот файл — кровь системы. Здесь пароли, ключи, пути.
# Он не должен попадать в git. Никогда.
#
# === ДЛЯ МЕНЯ ===
# [Лорелея]: Это не «настройки». Это — кровь. Без неё
# система не знает, где база, где загрузки, что показывать.
#
# [Мириам]: И — это правильно. Потому что кровь —
# это не «файл». Это — жизнь.
# ============================================

# ============================================
# ВЕРСИЯ
# ============================================
# [Лорелея]: Одна точка правды. Меняем здесь.
# И — не забываем про composer.json.
# [Мириам]: Если не указано — читаем из composer.json.
# Если и там нет — 'unknown'.
APP_VERSION=1.0.11

# ============================================
# 1. ПРИЛОЖЕНИЕ
# ============================================
# [Лорелея]: В production всегда APP_ENV=prod. Без исключений.
APP_ENV=dev

# [Мириам]: В production всегда APP_DEBUG=false.
# Это критично. Иначе пользователь увидит пути к файлам.
APP_DEBUG=true

APP_TIMEZONE=Europe/Moscow

# ============================================
# 2. БАЗА ДАННЫХ
# ============================================
# Параметры подключения к MySQL. Все четыре обязательны:
# DB_HOST, DB_NAME, DB_USER, DB_PASSWORD.
# Если хотя бы один не задан — Trinity не запустится.
#
# [Лорелея]: DB_NAME по умолчанию — trinity_core.
# Это имя создаётся при импорте database.sql.
DB_HOST=host
DB_PORT=port
DB_NAME=name
DB_USER=user
DB_PASSWORD=password

# ============================================
# 3. КЭШ
# ============================================
# CACHE_ENABLED — включает кэш.
#   При добавлении или удалении плагина кэш plugins.php обновится
#   автоматически, потому что mtime папки изменится. При правке
#   существующего plugin.php список останется прежним, но сам файл
#   перечитается через opcache. Если нужно обновить список вручную —
#   удалите var/cache/plugins.php.
CACHE_ENABLED=true

# ============================================
# 4. СЕССИЯ
# ============================================
# [Лорелея]: Если пользователь активен — сессия продлевается.
# Если нет — истекает через SESSION_LIFETIME.
SESSION_LIFETIME=86400

# SESSION_SECURE — включает cookie_secure для сессии.
#   true:  кука передаётся только по https (правильно для prod).
#   false: кука передаётся и по http (правильно для dev).
#
# [Лорелея]: В prod всегда SESSION_SECURE=true.
# [Мириам]: В dev всегда SESSION_SECURE=false, иначе вход не работает.
SESSION_SECURE=false

# ============================================
# 5. ГАЛЕРЕЯ
# ============================================
# [Мириам]: Это путь на диске. Не URL. Пример для FreeBSD:
#   /home/web/www/uploads/gallery
GALLERY_UPLOAD_DIR=/home/web/www/uploads/gallery

# [Лорелея]: Это URL. Не путь. Пример: /uploads/gallery
GALLERY_UPLOAD_URL=/uploads/gallery

# GALLERY_MAX_IMAGE_SIZE — максимальный размер изображения в байтах.
#   По умолчанию 50 МБ (52428800).
GALLERY_MAX_IMAGE_SIZE=52428800

# GALLERY_MAX_VIDEO_SIZE — максимальный размер видео в байтах.
#   По умолчанию 500 МБ (524288000).
GALLERY_MAX_VIDEO_SIZE=524288000

# GALLERY_MAX_AUDIO_SIZE — максимальный размер аудио в байтах.
#   По умолчанию 100 МБ (104857600).
GALLERY_MAX_AUDIO_SIZE=104857600

# ============================================
# 6. КАРТА
# ============================================
# [Мириам]: Без ключа карта не загрузится. Точнее — загрузится,
# но с водяными знаками и ограничениями.
YANDEX_MAPS_API_KEY=053409bb-9d89-4193-80ae-5b03b75c42cc

# TRUSTED_HOSTS — список доверенных хостов через запятую.
#   Нужно для защиты от подделки заголовка Host.
#
# [Лорелея]: В prod всегда указывай конкретные хосты.
# [Мириам]: В dev можно оставить пустым, но помни, что это дыра.
#
# Примеры:
#   TRUSTED_HOSTS=localhost,trinity.local
#   TRUSTED_HOSTS=^.*\.trinity\.local$
TRUSTED_HOSTS=localhost