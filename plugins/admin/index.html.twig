{% extends 'base.html.twig' %}

{% block body %}
<div class="d-flex">
	<aside class="sidebar" id="sidebar">
		<div class="skeleton-sidebar">
			<div class="skeleton-line skeleton-line-short"></div>
			<div class="skeleton-line skeleton-line-long"></div>
			<div class="skeleton-line skeleton-line-medium"></div>
		</div>
	</aside>

	<div class="main-content">
		<header class="top-bar" id="topBar">
			<div class="skeleton-topbar">
				<div class="skeleton-line skeleton-line-short"></div>
			</div>
		</header>

		<main>
			<div class="admin-layout">
				{# Дерево нейронов #}
				<div class="tree-panel">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<h6 class="gold-text mb-0">
							<i class="bi bi-diagram-3"></i> Нейроны
						</h6>
						<div class="d-flex gap-2">
							<button class="btn btn-sm btn-outline-gold" onclick="document.getElementById('importFile').click()" title="Импорт из Excel">
								<i class="bi bi-upload"></i>
							</button>
							<input type="file" id="importFile" accept=".xlsx,.xls" style="display:none;" onchange="importExcel(this.files[0])">
							<button class="btn btn-sm btn-outline-gold" onclick="adminCreateNeuron(null)">
								<i class="bi bi-plus-lg"></i>
							</button>
						</div>
					</div>
					
					{# Прогресс-бар импорта #}
					<div id="importProgressContainer" class="mb-3" style="display:none;">
						<div class="card bg-dark border-secondary">
							<div class="card-body py-2">
								<div class="d-flex justify-content-between align-items-center mb-1">
									<small class="text-muted" id="importStatusText">Импорт...</small>
									<small class="text-info" id="importPercentText">0%</small>
								</div>
								<div class="progress" style="height: 8px;">
									<div class="progress-bar progress-bar-striped progress-bar-animated bg-info" id="importProgressBar" role="progressbar" style="width: 0%;"></div>
								</div>
								<div id="importDetails" class="mt-1 small text-muted"></div>
							</div>
						</div>
					</div>
					<div id="neuronTree">
						<div class="text-center text-muted py-3">
							<div class="spinner-border spinner-border-sm"></div>
							Загрузка дерева...
						</div>
					</div>
				</div>

				{# Панель нейрона #}
				<div class="neuron-panel" id="neuronPanel">
					<div class="neuron-panel-empty">
						<i class="bi bi-arrow-left empty-icon"></i>
						<h5 class="mt-3">Выберите нейрон из дерева</h5>
						<p class="small">или нажмите + чтобы создать новый</p>
					</div>
				</div>
			</div>
		</main>
	</div>
</div>

{# Загружаем меню и topbar #}
<script>
fetch('/api/menu/sidebar').then(r => r.text()).then(html => document.getElementById('sidebar').innerHTML = html);
fetch('/api/menu/topbar').then(r => r.text()).then(html => {
	document.getElementById('topBar').innerHTML = html;
	setTimeout(initUserDropdown, 50);
});
</script>

<script src="/assets/js/menu.js"></script>
{# Скрипт админки (vanilla JS) #}
<script src="/assets/js/admin.js"></script>
{% endblock %}