{# Кнопки админа #}
{# Хлебные крошки #}
{% if breadcrumbs is not empty %}
    <div class="mb-3">
		<a href="#" class="gold-text" onclick="galleryGoHome()">Главная</a>
        {% for bc in breadcrumbs %}
			<span class="text-muted">/</span>
            {% if loop.last %}
                <span class="text-muted">{{ bc.name }}</span>
            {% elseif bc.type == 'tree' %}
                <a href="#" class="gold-text" onclick="goToSection({{ bc.id }}, '{{ bc.name|e('js') }}')">{{ bc.name }}</a>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}

{% if isAdmin %}
<div class="mb-3">
	<button class="btn btn-sm btn-outline-gold" id="galleryEditButton">
		<i class="bi bi-pencil"></i> Редактировать
	</button>
	<button class="btn btn-sm btn-outline-gold" id="galleryDeleteItemButton">
		<i class="bi bi-trash"></i> Удалить
	</button>
	<button class="btn btn-sm btn-outline-gold" id="galleryAddPhotoButton">
		<i class="bi bi-plus-lg"></i> Добавить фото
	</button>
	<input type="file" id="galleryAddPhotoInput" multiple accept="image/*" style="display:none">
</div>

{# Форма редактирования #}
<div id="galleryEditForm" style="display:none;" class="card bg-dark border-gold mb-3">
	<div class="card-body">
		<div class="mb-2">
			<label class="form-label small">Название</label>
			<input type="text" id="editName" class="form-control form-control-sm" value="{{ item.name }}">
		</div>
		<div class="mb-2">
			<label class="form-label small">Описание</label>
			<textarea id="editDescription" class="form-control form-control-sm" rows="4">{{ item.description }}</textarea>
		</div>
		<hr class="border-gold">
		<div class="row g-2">
			<div class="col-6">
				<label class="form-label small">Вид искусства</label>
				<input type="text" id="editArtType" class="form-control form-control-sm" value="{{ item.data.meta.art_type|default('') }}">
			</div>
			<div class="col-6">
				<label class="form-label small">Сюжет и объекты</label>
				<input type="text" id="editSubject" class="form-control form-control-sm" value="{{ item.data.meta.subject|default('') }}">
			</div>
			<div class="col-6">
				<label class="form-label small">Стиль</label>
				<input type="text" id="editStyle" class="form-control form-control-sm" value="{{ item.data.meta.style|default('') }}">
			</div>
			<div class="col-6">
				<label class="form-label small">Техника</label>
				<input type="text" id="editTechnique" class="form-control form-control-sm" value="{{ item.data.meta.technique|default('') }}">
			</div>
			<div class="col-4">
				<label class="form-label small">Материалы</label>
				<input type="text" id="editMaterials" class="form-control form-control-sm" value="{{ item.data.meta.materials|default('') }}">
			</div>
			<div class="col-4">
				<label class="form-label small">Размер</label>
				<input type="text" id="editSize" class="form-control form-control-sm" value="{{ item.data.meta.size|default('') }}">
			</div>
			<div class="col-4">
				<label class="form-label small">Местонахождение</label>
				<input type="text" id="editLocation" class="form-control form-control-sm" value="{{ item.data.meta.location|default('') }}">
			</div>
		</div>
		<div class="mt-3">
			<button class="btn btn-sm btn-outline-gold" id="gallerySaveButton">
				<i class="bi bi-check-lg"></i> Сохранить
			</button>
			<button class="btn btn-sm btn-outline-secondary" id="galleryCancelButton">Отмена</button>
		</div>
	</div>
</div>
{% endif %}


<div id="galleryItemInfo">
	{% if item.name is defined and item.name %}
		<h4 class="gold-text mb-2">{{ item.name }}</h4>
	{% endif %}

	{% if item.description is defined and item.description %}
		<p class="text-muted mb-3">{{ item.description }}</p>
	{% endif %}

	{# Метаданные #}
	{% if item.data is defined %}
		{% if item.data.meta is defined and item.data.meta is not empty %}
			<div class="card bg-dark border-gold mb-3">
				<div class="card-body py-2 px-3">
					<table class="table table-dark table-sm mb-0">
						{% if item.data.meta.art_type is defined %}
						<tr><th class="text-muted" style="width:150px;">Вид искусства</th><td>{{ item.data.meta.art_type }}</td></tr>
						{% endif %}
						{% if item.data.meta.subject is defined %}
						<tr><th class="text-muted">Сюжет и объекты</th><td>{{ item.data.meta.subject }}</td></tr>
						{% endif %}
						{% if item.data.meta.style is defined %}
						<tr><th class="text-muted">Стиль</th><td>{{ item.data.meta.style }}</td></tr>
						{% endif %}
						{% if item.data.meta.technique is defined %}
						<tr><th class="text-muted">Техника</th><td>{{ item.data.meta.technique }}</td></tr>
						{% endif %}
						{% if item.data.meta.materials is defined %}
						<tr><th class="text-muted">Материалы</th><td>{{ item.data.meta.materials }}</td></tr>
						{% endif %}
						{% if item.data.meta.size is defined %}
						<tr><th class="text-muted">Размер</th><td>{{ item.data.meta.size }}</td></tr>
						{% endif %}
						{% if item.data.meta.location is defined %}
						<tr><th class="text-muted">Местонахождение</th><td>{{ item.data.meta.location }}</td></tr>
						{% endif %}
						{% if item.data.year is defined %}
						<tr><th class="text-muted">Дата создания</th><td>{{ item.data.year }}</td></tr>
						{% endif %}
					</table>
				</div>
			</div>
		{% endif %}
	{% endif %}
</div>

<div class="gallery-full">
	{% for photo in photos %}
		{% if item.data.is_video %}
			<div class="gallery-full-item">
				<video controls autoplay muted loop style="width:100%; max-height:80vh;">
					<source src="{{ photo.full }}" type="{{ item.data.mime }}">
					Ваш браузер не поддерживает видео.
				</video>
			</div>
		{% elseif item.data.is_audio %}
			<div class="p-4">
				<audio controls autoplay style="width:100%;">
					<source src="{{ photo.full }}" type="{{ item.data.mime }}">
				</audio>
			</div>
		{% else %}
			<div class="gallery-full-item">
				<img src="{{ photo.full }}" alt="{{ photo.title }}" loading="lazy">
			</div>
		{% endif %}
	{% endfor %}
</div>