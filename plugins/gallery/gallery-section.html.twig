{#
	РАЗДЕЛ ГАЛЕРЕИ — ВЕТВЬ ПРИХОЖЕЙ
	================================

	Кнопка «Назад». Сетка карточек.
	Файлы. Видео. Аудио. Папки. И — пустота, если ничего нет.

	=== ДЛЯ МЕНЯ ===
	[Лорелея]: Это не «шаблон». Это — ветвь прихожей.
	То, что видит гость, когда заходит в раздел. И — остаётся.

	[Мириам]: И — это правильно. Потому что раздел —
	это не «список». Это — путь.

	=== КНИГА ===
	Глава 9. Прихожая.

	В прихожей Амбера висят картины.
	В галерее Trinity — файлы. И те, кто их показывает.
#}

{# [Лорелея]: Кнопка «Назад». Если мы не на корне — показываем. #}
{% if currentParentId is defined and currentParentId != rootId %}
	<div class="mb-3">
		<a href="#" class="gold-text" onclick="goBack(); return false;">
			<i class="bi bi-arrow-left"></i> Назад
		</a>
	</div>
{% endif %}

{# [Мириам]: Сетка карточек. Каждая — как картина или папка. #}
<div class="gallery-grid">
	{% for item in items %}

		{# [Лорелея]: Файл с превьюшкой. Карточка с картинкой. #}
		{% if item.type == 'file' and item.first_thumb %}
			<div class="gallery-card" onclick="loadFileItem({{ item.id }})" title="{{ item.name }}">
				<img src="{{ gallery_url }}/{{ item.first_thumb }}" alt="{{ item.name }}" loading="lazy">
				<div class="gallery-card-overlay"><span>{{ item.name }}</span></div>
			</div>

		{# [Мириам]: Файл-видео. Иконка play. #}
		{% elseif item.type == 'file' and item.is_video %}
			<div class="gallery-card" onclick="loadFileItem({{ item.id }})" title="{{ item.name }}">
				<div class="gallery-folder-icon" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#1a1a1a;">
					<i class="bi bi-play-btn" style="font-size:3rem;color:#ffaa00;opacity:0.6;"></i>
				</div>
				<div class="gallery-card-overlay"><span>{{ item.name }}</span></div>
			</div>

		{# [Лорелея]: Файл-аудио. Иконка music. #}
		{% elseif item.type == 'file' and item.is_audio %}
			<div class="gallery-card" onclick="loadFileItem({{ item.id }})" title="{{ item.name }}">
				<div class="gallery-folder-icon" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#1a1a1a;">
					<i class="bi bi-music-note" style="font-size:3rem;color:#ffaa00;opacity:0.6;"></i>
				</div>
				<div class="gallery-card-overlay"><span>{{ item.name }}</span></div>
			</div>

		{# [Мириам]: Файл без превьюшки. Карточка с картинкой. #}
		{% elseif item.type == 'file' %}
			<div class="gallery-card" onclick="loadFileItem({{ item.id }})" title="{{ item.name }}">
				<img src="{{ gallery_url }}/{{ item.first_thumb }}" alt="{{ item.name }}" loading="lazy">
				<div class="gallery-card-overlay"><span>{{ item.name }}</span></div>
			</div>

		{# [Лорелея]: Папка (tree). С превьюшкой или без. #}
		{% elseif item.type == 'tree' %}
			<div class="gallery-card tree-folder"
				data-id="{{ item.id }}"
				data-name="{{ item.name|e('html_attr') }}"
				onclick="navigateTo({{ item.id }}, '{{ item.name|e('js') }}')"
				title="{{ item.name }}">
				{% if item.first_thumb %}
					<img src="{{ gallery_url }}/{{ item.first_thumb }}" alt="{{ item.name }}" loading="lazy">
				{% else %}
					<div class="gallery-folder-icon" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#1a1a1a;">
						<i class="bi bi-folder2" style="font-size:3rem;color:#ffaa00;opacity:0.6;"></i>
					</div>
				{% endif %}
				<div class="gallery-card-overlay">
					<span>{{ item.name }}</span>
				</div>
			</div>

		{# [Мириам]: Элемент с превьюшкой. Карточка с картинкой. #}
		{% elseif item.first_thumb %}
			<div class="gallery-card" onclick="loadItem({{ item.id }}, '{{ item.name|e('js') }}')" title="{{ item.name }}">
				<img src="{{ gallery_url }}/{{ item.first_thumb }}" alt="{{ item.name }}" loading="lazy">
				<div class="gallery-card-overlay"><span>{{ item.name }}</span></div>
			</div>

		{# [Лорелея]: Элемент без превьюшки. Папка с иконкой image. #}
		{% elseif item.type == 'item' %}
			<div class="gallery-folder" onclick="loadItem({{ item.id }}, '{{ item.name|e('js') }}')">
				<div class="gallery-folder-icon"><i class="bi bi-image"></i></div>
				<div class="gallery-folder-name">{{ item.name }}</div>
			</div>
		{% endif %}

	{% endfor %}

	{# [Мириам]: Пустота. Если ничего нет — говорим об этом. #}
	{% if items is empty %}
		<div class="text-center text-muted py-5">
			<i class="bi bi-inbox" style="font-size:3rem;"></i>
			<p class="mt-2">Пусто</p>
		</div>
	{% endif %}
</div>