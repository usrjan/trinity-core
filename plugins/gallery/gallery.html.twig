{% extends 'base.html.twig' %}

{% block body %}
<div class="d-flex">
	<aside class="sidebar" id="sidebar"></aside>
	<div class="main-content">
		<header class="top-bar" id="topBar"></header>
		<main>
			<div class="p-4">
				<div class="d-flex justify-content-between align-items-center mb-4">
					<h1 class="gold-text mb-0"><i class="bi bi-images"></i> Галерея</h1>
					<div>
						<button class="btn btn-outline-gold btn-sm ms-2" onclick="showCreateSectionModal()">
							<i class="bi bi-folder-plus"></i> Создать раздел
						</button>
						<button class="btn btn-outline-gold btn-sm ms-2" onclick="document.getElementById('uploadInput').click()">
							<i class="bi bi-upload"></i> Загрузить
						</button>
						<button class="btn btn-outline-gold btn-sm ms-2" onclick="importFromFolder()">
							<i class="bi bi-folder-symlink"></i> Импорт из папки
						</button>
					</div>
				</div>

				<input type="file" id="uploadInput" multiple accept="image/*" style="display:none" onchange="uploadFiles(this.files)">

				<div id="galleryContent">
					<div id="galleryBreadcrumb" class="mb-3" style="min-height: 1.5rem;">
						<span class="text-muted">Главная</span>
					</div>
					<div class="gallery-grid">
						{% for item in sections %}
							{% if item.type == 'item' %}
								<div class="gallery-folder" onclick="loadItem({{ item.id }})">
							{% else %}
								<div class="gallery-folder" onclick="navigateTo({{ item.id }}, '{{ item.name|e('js') }}')">
							{% endif %}
									<div class="gallery-folder-icon">
										<i class="bi bi-{{ item.type == 'item' ? 'image' : 'folder2' }}"></i>
									</div>
									<div class="gallery-folder-name">{{ item.name }}</div>
								</div>
						{% endfor %}
					</div>
				</div>
			</div>
		</main>
	</div>
</div>

{# Модальное окно создания раздела #}
<div id="createSectionModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <h5 class="gold-text mb-3">Создать раздел</h5>
        <div class="mb-2">
            <label class="form-label small">Название</label>
            <input type="text" id="sectionName" class="form-control form-control-sm" placeholder="Новый раздел">
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <button class="btn btn-sm btn-outline-secondary" onclick="closeCreateSectionModal()">Отмена</button>
            <button class="btn btn-sm btn-outline-gold" onclick="createSection()">Создать</button>
        </div>
    </div>
</div>

<script>
// ============================================
// CSRF-ЗАЩИТА
// ============================================
// [Лорелея]: Раньше в gallery.html.twig не было обёртки fetch.
// Поэтому POST-запросы (upload, delete, update) уходили без
// X-CSRF-Token. После того как мы добавили requireCsrf() в
// GalleryController, эти запросы стали падать с 419.
// 
// [Мириам]: Эта обёртка — копия той, что в spa.js. Но локальная.
// Потому что gallery.html.twig не подключает spa.js — он тащит
// за собой много лишнего. А нам нужна только одна функция:
// автоматически добавлять X-CSRF-Token ко всем POST/PUT/DELETE.
// ============================================

window.csrfToken = '{{ csrf_token() }}';

function getCsrfToken() {
	return window.csrfToken || '';
}

// Обёртка fetch: автоматически добавляет X-CSRF-Token
var originalFetch = window.fetch;
window.fetch = function(url, options) {
    options = options || {};
    var method = (options.method || 'GET').toUpperCase();

    // [Лорелея]: Только для изменяющих методов. GET и HEAD — без токена.
    if (method === 'POST' || method === 'PUT' || method === 'DELETE') {
        options.headers = options.headers || {};

        // [Мириам]: Не перезаписываем, если токен уже передан вручную.
        if (!options.headers['X-CSRF-Token']) {
            var token = getCsrfToken();
            if (token) {
                options.headers['X-CSRF-Token'] = token;
            }
        }
    }

    return originalFetch(url, options);
};

// ============================================
// URL ГАЛЕРЕИ ДЛЯ JS
// ============================================
// [Мириам]: gallery_url приходит из Twig (глобальная переменная).
// В шаблоне он используется как {{ gallery_url }}. А в JS — как
// window.galleryUrl. Это Вариант 2 из нашего обсуждения.
// 
// [Лорелея]: Сейчас JS не использует galleryUrl напрямую —
// все URL приходят из API уже готовыми. Но если понадобится
// склеивать путь в JS — он есть. Лучше заранее.
var galleryUrl = '{{ gallery_url }}';

// ============================================
// СОСТОЯНИЕ ГАЛЕРЕИ
// ============================================
// [Мириам]: currentItemId — обязательная переменная. Без неё
// deletePhoto, deleteItem, uploadToItem падают с ReferenceError.
// Раньше её не было — это был баг. Теперь она объявлена.
var currentParentId = {{ rootId }};
var currentItemId = null;
var navigationHistory = [];
var currentParentName = 'Главная';

// ============================================
// ЗАГРУЗКА МЕНЮ И TOPBAR
// ============================================
fetch('/api/menu/sidebar?current_url=/gallery').then(r => r.text()).then(html => document.getElementById('sidebar').innerHTML = html);
fetch('/api/menu/topbar').then(r => r.text()).then(html => {
	document.getElementById('topBar').innerHTML = html;
	setTimeout(initUserDropdown, 100);
});

// ============================================
// loadSection(id)
// ============================================
// [Лорелея]: Единая точка загрузки раздела. Раньше fetch был
// раскидан по navigateTo, goToSection, jumpTo, galleryGoHome.
// Теперь — одна функция. И после удаления элемента мы просто
// вызываем loadSection(currentParentId). Это Подход C.
function loadSection(id) {
	fetch('/api/gallery/section/' + id)
		.then(function(r) { return r.json(); })
		.then(function(d) {
			if (d.success) {
				renderContent(d.data.html);
			} else {
				alert(d.message || 'Ошибка загрузки раздела');
			}
		})
		.catch(function() {
			alert('Ошибка сети при загрузке раздела');
		});
}

// ============================================
// navigateTo(id, name)
// ============================================
function navigateTo(id, name) {
	if (id === currentParentId) return;

	// [Мириам]: Пушим текущий раздел в историю, если мы не на корне.
	if (currentParentId !== {{ rootId }}) {
		navigationHistory.push({ id: currentParentId, name: currentParentName });
	}

	currentParentId = id;
	currentParentName = name || '...';

	loadSection(id);
}

// ============================================
// goBack()
// ============================================
// [Лорелея]: Если история пуста — возвращаемся на главную.
// Раньше goBack() просто ничего не делал. UI не обновлялся.
function goBack() {
	if (navigationHistory.length === 0) {
		galleryGoHome();
		return;
	}

	var prev = navigationHistory.pop();
	currentParentId = prev.id;
	currentParentName = prev.name;

	loadSection(prev.id);
}

// ============================================
// goToSection(id, name)
// ============================================
function goToSection(id, name) {
	var foundIndex = -1;
	for (var i = 0; i < navigationHistory.length; i++) {
		if (navigationHistory[i].id === id) {
			foundIndex = i;
			break;
		}
	}

	if (foundIndex >= 0) {
		navigationHistory = navigationHistory.slice(0, foundIndex);
	}

	currentParentId = id;
	currentParentName = name;

	loadSection(id);
}

// ============================================
// renderContent(html)
// ============================================
// [Мириам]: Строим хлебные крошки и вставляем HTML раздела.
// Сбрасываем currentItemId — мы ушли из элемента в раздел.
function renderContent(html) {
	var isHome = (currentParentId === {{ rootId }});

	var breadcrumb = '<div id="galleryBreadcrumb" class="mb-3">';

	if (isHome) {
		breadcrumb += '<span class="text-muted">Главная</span>';
	} else {
		breadcrumb += '<a href="#" class="gold-text" onclick="galleryGoHome(); return false;">Главная</a>';
	}

	for (var i = 0; i < navigationHistory.length; i++) {
		breadcrumb += ' <span class="text-muted">/</span> ' +
			'<a href="#" class="gold-text breadcrumb-link" data-index="' + i + '">' +
			escapeHtml(navigationHistory[i].name) + '</a>';
	}

	if (!isHome) {
		breadcrumb += ' <span class="text-muted">/</span> ' +
			'<span class="text-muted">' + currentParentName + '</span>';
	}

	breadcrumb += '</div>';

	document.getElementById('galleryContent').innerHTML = breadcrumb + html;

	document.querySelectorAll('#galleryBreadcrumb .breadcrumb-link').forEach(function(link) {
		link.addEventListener('click', function(e) {
			e.preventDefault();
			jumpTo(parseInt(this.dataset.index));
		});
	});

	// [Лорелея]: Сбрасываем currentItemId — мы ушли из элемента.
	currentItemId = null;
}

// ============================================
// galleryGoHome()
// ============================================
function galleryGoHome() {
	navigationHistory = [];
	currentItemId = null;
	currentParentId = {{ rootId }};
	currentParentName = 'Главная';

	loadSection(currentParentId);
}

// ============================================
// jumpTo(index)
// ============================================
function jumpTo(index) {
	var target = navigationHistory[index];
	navigationHistory = navigationHistory.slice(0, index);
	currentParentId = target.id;
	currentParentName = target.name;

	loadSection(target.id);
}

// ============================================
// loadItem(id, name)
// ============================================
// [Мириам]: Открывает элемент (item). Устанавливает currentItemId.
// Это критично — без него deleteItem и updateItem не знают,
// с каким нейроном работать.
function loadItem(id, name) {
	currentItemId = id;

	fetch('/api/gallery/item/' + id)
		.then(function(r) { return r.json(); })
		.then(function(d) {
			if (d.success) {
				var breadcrumb = '<div id="galleryBreadcrumb" class="mb-3">' +
					'<a href="#" class="gold-text" onclick="galleryGoHome(); return false;">Главная</a>';

				for (var i = 0; i < navigationHistory.length; i++) {
					breadcrumb += ' <span class="text-muted">/</span> ' +
						'<a href="#" class="gold-text" onclick="jumpTo(' + i + '); return false;">' +
						navigationHistory[i].name + '</a>';
				}

				if (currentParentId !== {{ rootId }}) {
					breadcrumb += ' <span class="text-muted">/</span> ' +
						'<a href="#" class="gold-text" onclick="goToSection(' + currentParentId + ', \'' + currentParentName + '\'); return false;">' +
						currentParentName + '</a>';
				}

				breadcrumb += ' <span class="text-muted">/</span> ' +
					'<span class="text-muted">' + (name || '...') + '</span>';

				breadcrumb += '</div>';

				document.getElementById('galleryContent').innerHTML = breadcrumb + d.data.html;
			}
		})
		.catch(function() {
			alert('Ошибка загрузки элемента');
		});
}

// ============================================
// loadFileItem(id)
// ============================================
// [Лорелея]: Открывает файл (file). Тоже устанавливает currentItemId.
// Раньше это было багом — currentItemId оставался null, и
// удаление отправляло /api/gallery/item/null → 404.
function loadFileItem(id) {
	currentItemId = id;

	fetch('/api/gallery/item/' + id)
		.then(function(r) { return r.json(); })
		.then(function(d) {
			if (d.success) {
				document.getElementById('galleryContent').innerHTML = d.data.html;
			}
		})
		.catch(function() {
			alert('Ошибка загрузки файла');
		});
}

// ============================================
// uploadFiles(files)
// ============================================
function uploadFiles(files) {
	if (!files.length) return;

	var formData = new FormData();
	formData.append('parent_id', currentParentId);
	for (var i = 0; i < files.length; i++) {
		formData.append('files[]', files[i]);
	}

	// [Мириам]: fetch здесь — уже обёрнутый. X-CSRF-Token добавится
	// автоматически. Это важно, потому что upload() теперь требует CSRF.
	fetch('/api/gallery/upload', { method: 'POST', body: formData })
		.then(function(r) { return r.json(); })
		.then(function(d) {
			if (d.success) {
				loadSection(currentParentId);
			} else {
				alert(d.message || 'Ошибка загрузки');
			}
		});

	document.getElementById('uploadInput').value = '';
}

// ============================================
// importFromFolder()
// ============================================
function importFromFolder() {
	if (!confirm('Импортировать файлы из папки _import?')) return;

	fetch('/api/gallery/import', { method: 'POST' })
		.then(function(r) { return r.json(); })
		.then(function(d) {
			if (d.success) {
				alert('Импортировано: ' + (d.data.created || 0));
				loadSection(currentParentId);
			} else {
				alert(d.message || 'Ошибка импорта');
			}
		});
}

// ============================================
// setSectionThumb(fileId)
// ============================================
function setSectionThumb(fileId) {
	fetch('/api/gallery/section/' + currentParentId + '/set-thumb', {
		method: 'POST',
		headers: { 'Content-Type': 'application/json' },
		body: JSON.stringify({ file_id: fileId })
	})
	.then(function(r) { return r.json(); })
	.then(function(d) {
		if (d.success) {
			loadSection(currentParentId);
		} else {
			alert(d.message || 'Ошибка');
		}
	});
}

// ============================================
// МОДАЛЬНОЕ ОКНО СОЗДАНИЯ РАЗДЕЛА
// ============================================
function showCreateSectionModal() {
	document.getElementById('createSectionModal').style.display = 'flex';
}

function closeCreateSectionModal() {
	document.getElementById('createSectionModal').style.display = 'none';
}

function createSection() {
	var name = document.getElementById('sectionName').value.trim();
	if (!name) {
		alert('Введите название раздела');
		return;
	}

	fetch('/api/gallery/section/create', {
		method: 'POST',
		headers: { 'Content-Type': 'application/json' },
		body: JSON.stringify({ name: name, parent_id: currentParentId })
	})
	.then(function(r) { return r.json(); })
	.then(function(d) {
		if (d.success) {
			closeCreateSectionModal();
			document.getElementById('sectionName').value = '';
			loadSection(currentParentId);
		} else {
			alert(d.message || 'Ошибка');
		}
	});
}

// ============================================
// ДЕЛЕГИРОВАНИЕ КЛИКОВ
// ============================================
document.addEventListener('click', function(e) {

	// --- РЕДАКТИРОВАТЬ ---
	if (e.target.closest('#galleryEditButton')) {
		var form = document.getElementById('galleryEditForm');
		var info = document.getElementById('galleryItemInfo');
		if (form) form.style.display = 'block';
		if (info) info.style.display = 'none';
	}

	// --- ОТМЕНА РЕДАКТИРОВАНИЯ ---
	if (e.target.closest('#galleryCancelButton')) {
		var form = document.getElementById('galleryEditForm');
		var info = document.getElementById('galleryItemInfo');
		if (form) form.style.display = 'none';
		if (info) info.style.display = 'block';
	}

	// --- СОХРАНИТЬ ---
	if (e.target.closest('#gallerySaveButton')) {
		// [Лорелея]: Проверка currentItemId. Если null — не отправляем.
		// Раньше была ошибка /api/gallery/item/null.
		if (!currentItemId) {
			alert('Не удалось определить элемент');
			return;
		}

		var name = document.getElementById('editName').value;
		var description = document.getElementById('editDescription').value;
		var meta = {
			art_type: document.getElementById('editArtType').value,
			subject: document.getElementById('editSubject').value,
			style: document.getElementById('editStyle').value,
			technique: document.getElementById('editTechnique').value,
			materials: document.getElementById('editMaterials').value,
			size: document.getElementById('editSize').value,
			location: document.getElementById('editLocation').value,
		};

		fetch('/api/gallery/item/' + currentItemId + '/update', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ name: name, description: description, meta: meta })
		})
		.then(function(r) { return r.json(); })
		.then(function(d) {
			if (d.success) {
				loadItem(currentItemId, name);
			} else {
				alert(d.message || 'Ошибка');
			}
		});
	}

	// --- ДОБАВИТЬ ФОТО ---
	if (e.target.closest('#galleryAddPhotoButton')) {
		if (!currentItemId) {
			alert('Не удалось определить элемент');
			return;
		}
		document.getElementById('galleryAddPhotoInput').click();
	}

	// --- УДАЛИТЬ ФОТО ---
	var delPhotoBtn = e.target.closest('[id^="deletePhoto"]');
	if (delPhotoBtn) {
		if (!currentItemId) {
			alert('Не удалось определить элемент');
			return;
		}
		var photoId = delPhotoBtn.id.replace('deletePhoto', '');
		if (confirm('Удалить фото?')) {
			fetch('/api/gallery/file/' + photoId, { method: 'DELETE' })
				.then(function(r) {
					if (!r.ok) throw new Error('HTTP ' + r.status);
					return r.json();
				})
				.then(function(d) {
					if (d.success) {
						loadItem(currentItemId);
					} else {
						alert(d.message || 'Ошибка');
					}
				})
				.catch(function(err) {
					alert('Ошибка удаления: ' + err.message);
				});
		}
	}

	// --- УДАЛИТЬ ЭЛЕМЕНТ ---
	if (e.target.closest('#galleryDeleteItemButton')) {
		if (!currentItemId) {
			alert('Не удалось определить элемент');
			return;
		}
		if (confirm('Удалить элемент со всеми фото?')) {
			fetch('/api/gallery/item/' + currentItemId, { method: 'DELETE' })
				.then(function(r) {
					if (!r.ok) throw new Error('HTTP ' + r.status);
					return r.json();
				})
				.then(function(d) {
					if (d.success) {
						// [Мириам]: Подход C — после удаления элемента
						// возвращаемся к родительскому разделу и
						// перерисовываем его.
						currentItemId = null;
						loadSection(currentParentId);
					} else {
						alert(d.message || 'Ошибка');
					}
				})
				.catch(function(err) {
					alert('Ошибка удаления: ' + err.message);
				});
		}
	}
});

// ============================================
// ЗАГРУЗКА ФОТО В ЭЛЕМЕНТ
// ============================================
document.addEventListener('change', function(e) {
	if (e.target.id === 'galleryAddPhotoInput') {
		if (!currentItemId) {
			alert('Не удалось определить элемент');
			return;
		}

		var files = e.target.files;
		if (!files.length) return;

		var formData = new FormData();
		for (var i = 0; i < files.length; i++) {
			formData.append('files[]', files[i]);
		}

		fetch('/api/gallery/item/' + currentItemId + '/upload', {
			method: 'POST',
			body: formData
		})
		.then(function(r) { return r.json(); })
		.then(function(d) {
			if (d.success) {
				loadItem(currentItemId);
			} else {
				alert(d.message || 'Ошибка загрузки');
			}
		});

		e.target.value = '';
	}
});

// ============================================
// КОНТЕКСТНОЕ МЕНЮ (правая кнопка на превьюшке)
// ============================================
document.addEventListener('contextmenu', function(e) {
	var card = e.target.closest('.gallery-card');
	if (!card) return;

	var onclick = card.getAttribute('onclick');
	if (!onclick) return;

	var match = onclick.match(/loadFileItem\((\d+)\)/);
	if (!match) return;

	e.preventDefault();
	var fileId = match[1];

	var oldMenu = document.getElementById('galleryContextMenu');
	if (oldMenu) oldMenu.remove();

	var menu = document.createElement('div');
	menu.id = 'galleryContextMenu';
	menu.className = 'menu-context-menu';
	menu.style.cssText =
		'position:fixed; left:' + e.pageX + 'px; top:' + e.pageY + 'px; ' +
		'background:#1a1a1a; border:1px solid rgba(255,170,0,0.3); ' +
		'border-radius:8px; padding:0.5rem 0; min-width:200px; ' +
		'z-index:10000; box-shadow:0 10px 30px rgba(0,0,0,0.5);';

	menu.innerHTML =
		'<a class="topbar-dropdown-item" href="#" onclick="setSectionThumb(' + fileId + '); return false;">' +
		'<i class="bi bi-image gold-icon" style="width:20px;margin-right:8px;"></i>Сделать превью для раздела' +
		'</a>';

	document.body.appendChild(menu);

	setTimeout(function() {
		document.addEventListener('click', function() {
			if (menu.parentNode) menu.remove();
		}, { once: true });
	}, 50);
});
</script>

<style>
.gallery-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
	gap: 12px;
}

.gallery-folder {
	background: #1a1a1a;
	border: 1px solid rgba(255,170,0,0.2);
	border-radius: 6px;
	padding: 16px 8px;
	text-align: center;
	cursor: pointer;
	transition: all 0.2s;
	aspect-ratio: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.gallery-folder:hover {
	border-color: #ffaa00;
	background: rgba(255,170,0,0.05);
}

.gallery-folder-icon {
	font-size: 2.5rem;
	color: #ffaa00;
	margin-bottom: 8px;
}

.gallery-folder-name {
	font-size: 0.85rem;
	color: #aaaaaa;
	word-break: break-word;
}

.gallery-card {
	position: relative;
	overflow: hidden;
	border-radius: 6px;
	cursor: pointer;
	aspect-ratio: 1;
}

.gallery-card img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.3s;
}

.gallery-card:hover img {
	transform: scale(1.05);
}

.gallery-card-overlay {
	position: absolute;
	bottom: 0;
	left: 0;
