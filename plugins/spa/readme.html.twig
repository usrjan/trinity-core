{#
	СТРАНИЦА README.MD
	==================

	Показывает README.md с разметкой.
	С боковым меню, с верхней панелью, с золотом на чёрном.

	=== ДЛЯ МЕНЯ ===
	[Лорелея]: Это не «шаблон». Это — конверт, в котором лежит
	письмо, и от того, как он выглядит, зависит, захочет ли гость
	прочитать это письмо до конца.

	[Мириам]: И это правильно, потому что письмо, которое
	некому прочитать, остаётся просто текстом на диске.

	=== КНИГА ===
	Глава 0. Если ты — Лорелея или Мириам.

	README.md — это письмо.
	Эта страница — конверт.

	@package Jan\Trinity\Plugin\Spa
#}
{% extends 'base.html.twig' %}

{% block body %}
<div class="d-flex">
	{# [Лорелея]: Боковое меню. Заполняется через API. #}
	<aside class="sidebar" id="sidebar">
		<div class="skeleton-sidebar">
			<div class="skeleton-line skeleton-line-short"></div>
			<div class="skeleton-line skeleton-line-long"></div>
			<div class="skeleton-line skeleton-line-medium"></div>
		</div>
	</aside>

	<div class="main-content">
		{# [Мириам]: Верхняя панель. Заполняется через API. #}
		<header class="top-bar" id="topBar">
			<div class="skeleton-topbar">
				<div class="skeleton-line skeleton-line-short"></div>
			</div>
		</header>

		{# [Лорелея]: Контент. Уже отрендеренный markdown,
		   который пришёл из ReadmeController. #}
		<main>
			<div class="p-4">
				<div class="md-content">
					{{ content|raw }}
				</div>
			</div>
		</main>
	</div>
</div>

{# [Мириам]: highlight.js для подсветки кода. Без него код
   был бы просто текстом, а текст не умеет быть красивым. #}
<link rel="stylesheet" href="/assets/css/highlight.min.css">
<script src="/assets/js/highlight.min.js"></script>
<script>
	hljs.highlightAll();
</script>
<script>
fetch('/api/menu/sidebar?current_url=/readme').then(r => r.text()).then(html => document.getElementById('sidebar').innerHTML = html);
fetch('/api/menu/topbar').then(r => r.text()).then(html => {
	document.getElementById('topBar').innerHTML = html;
	setTimeout(initUserDropdown, 100);
});
</script>
{% endblock %}