{% extends 'base.html.twig' %}

{% block body %}
<div class="d-flex">
	<aside class="sidebar" id="sidebar"></aside>
	<div class="main-content">
		<header class="top-bar" id="topBar"></header>
		<main>
			<div class="p-4">
				<h1><i class="bi bi-pencil gold-text"></i> Редактирование профиля</h1>

				<div class="card bg-dark border-gold">
					<div class="card-body">
						<form method="POST" action="/profile/edit">
							<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
							<div class="mb-3">
								<label class="form-label">Язык интерфейса</label>
								<select name="lang" class="form-select">
									{% for code, name in available_langs %}
										<option value="{{ code }}" {% if user.lang == code %}selected{% endif %}>{{ name }}</option>
									{% endfor %}
								</select>
							</div>
							<div class="mb-3">
								<label class="form-label">Email</label>
								<input type="email" class="form-control" name="email" value="{{ user.email }}">
							</div>
							<div class="mb-3">
								<label class="form-label">Телефон</label>
								<input type="text" class="form-control" name="phone" value="{{ user.phone }}">
							</div>
							<hr>
							<p class="text-muted small">Оставьте пустым если не хотите менять пароль</p>
							<div class="mb-3">
								<label class="form-label">Новый пароль</label>
								<input type="password" class="form-control" name="new_password" minlength="8">
							</div>
							<div class="mb-3">
								<label class="form-label">Подтверждение пароля</label>
								<input type="password" class="form-control" name="password_confirm" minlength="8">
							</div>
							<button type="submit" class="btn btn-outline-gold">Сохранить</button>
							<a href="/profile" class="btn btn-outline-secondary">Отмена</a>
						</form>
					</div>
				</div>
			</div>
		</main>
	</div>
</div>

<script>
fetch('/api/menu/sidebar?current_url=/profile/edit').then(r => r.text()).then(html => document.getElementById('sidebar').innerHTML = html);
fetch('/api/menu/topbar').then(r => r.text()).then(html => {
	document.getElementById('topBar').innerHTML = html;
	setTimeout(initUserDropdown, 100);
});
</script>
{% endblock %}